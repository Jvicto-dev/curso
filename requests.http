@baseUrl = http://localhost:3333

# CRUD de usuario

### CREATE - cria um usuário
POST {{baseUrl}}/usuario
Content-Type: application/json

{
    "name": "pedro",
    "email": "pedro@email.com",
    "password": "9999"
}

###
# Passo a passo:
# 1. Rode o POST acima
# 2. Na resposta, copie o valor de "id"
# 3. Cole aqui embaixo, no lugar de COLE-O-ID-AQUI
# As rotas com /:id usam esse valor
@usuario_id = be347551-7e3a-41aa-a407-a36d07122893

### READ - lista todos os usuários
GET {{baseUrl}}/usuario

### READ - busca um usuário pelo id (rota ainda não criada)
GET {{baseUrl}}/usuario/{{usuario_id}}

### UPDATE - atualiza um usuário (rota ainda não criada)
PUT {{baseUrl}}/usuario/{{usuario_id}}
Content-Type: application/json

{
    "name": "joao silva 3333",
    "email": "joaozinho22@gmail.com",
    "password": "999999999999"
}

### DELETE - remove um usuário (rota ainda não criada)
DELETE {{baseUrl}}/usuario/{{usuario_id}}


# Login (JWT)

### LOGIN - devolve um token
# @name login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
    "email": "pedro@email.com",
    "password": "9999",
    "idade": 25
}

### ME - rota protegida: usa o token que o login devolveu
GET {{baseUrl}}/auth/me
Authorization: Bearer {{login.response.body.token}}
